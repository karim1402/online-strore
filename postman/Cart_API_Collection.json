{
	"info": {
		"_postman_id": "cart-api-collection",
		"name": "Makook - Cart API",
		"description": "Cart management endpoints for Makook application.\n\nAll endpoints require authentication via Bearer Token.\n\nSet the {{base_url}} and {{token}} variables before using.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "your_bearer_token_here",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Get Cart",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"description": "Use 'ar' for Arabic",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/user/cart",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"cart"
					]
				},
				"description": "Get user's cart with all items, options, and addons."
			},
			"response": []
		},
		{
			"name": "Add Item to Cart",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "product_id",
							"value": "1",
							"description": "Required - Product ID to add",
							"type": "text"
						},
						{
							"key": "quantity",
							"value": "1",
							"description": "Required - Quantity (1-99)",
							"type": "text"
						},
						{
							"key": "option_values[0]",
							"value": "1",
							"description": "Optional - First option value ID (e.g., size)",
							"type": "text",
							"disabled": true
						},
						{
							"key": "option_values[1]",
							"value": "5",
							"description": "Optional - Second option value ID (e.g., color)",
							"type": "text",
							"disabled": true
						},
						{
							"key": "addons[0][addon_id]",
							"value": "1",
							"description": "Optional - First addon ID",
							"type": "text",
							"disabled": true
						},
						{
							"key": "addons[0][quantity]",
							"value": "1",
							"description": "Optional - First addon quantity",
							"type": "text",
							"disabled": true
						},
						{
							"key": "addons[1][addon_id]",
							"value": "2",
							"description": "Optional - Second addon ID",
							"type": "text",
							"disabled": true
						},
						{
							"key": "addons[1][quantity]",
							"value": "2",
							"description": "Optional - Second addon quantity",
							"type": "text",
							"disabled": true
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/user/cart/items",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"cart",
						"items"
					]
				},
				"description": "Add a new item to the cart. If item with same product, options, and addons exists, quantity will be updated.\n\n**Note:** Adding items from a different store will clear the current cart."
			},
			"response": []
		},
		{
			"name": "Update Item Quantity",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "quantity",
							"value": "3",
							"description": "Required - New quantity (1-99)",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/user/cart/items/:itemId",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"cart",
						"items",
						":itemId"
					],
					"variable": [
						{
							"key": "itemId",
							"value": "1",
							"description": "Cart item ID"
						}
					]
				},
				"description": "Update the quantity of a specific cart item."
			},
			"response": []
		},
		{
			"name": "Update Cart Item (Full)",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "quantity",
							"value": "2",
							"description": "Optional - New quantity (1-99)",
							"type": "text",
							"disabled": true
						},
						{
							"key": "option_values[0]",
							"value": "3",
							"description": "Optional - First option value ID (replaces all options)",
							"type": "text",
							"disabled": true
						},
						{
							"key": "option_values[1]",
							"value": "7",
							"description": "Optional - Second option value ID",
							"type": "text",
							"disabled": true
						},
						{
							"key": "addons[0][addon_id]",
							"value": "1",
							"description": "Optional - Addon ID (replaces all addons)",
							"type": "text",
							"disabled": true
						},
						{
							"key": "addons[0][quantity]",
							"value": "2",
							"description": "Optional - Addon quantity",
							"type": "text",
							"disabled": true
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/user/cart/items/:itemId",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"cart",
						"items",
						":itemId"
					],
					"variable": [
						{
							"key": "itemId",
							"value": "1",
							"description": "Cart item ID"
						}
					]
				},
				"description": "Comprehensive update for a cart item. Can update:\n- **quantity**: Change item quantity\n- **option_values**: Replace all options (e.g., change size from M to L)\n- **addons**: Replace all addons (add/remove/update)\n\n**Examples:**\n- Change size only: Enable only option_values fields\n- Remove all addons: Send empty addons array\n- Update everything: Enable all fields\n\n**Note:** All fields are optional. Send only what you want to change."
			},
			"response": []
		},
		{
			"name": "Update Cart Item - Change Size Only",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "option_values[0]",
							"value": "5",
							"description": "New size option value ID (e.g., Large instead of Medium)",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/user/cart/items/:itemId",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"cart",
						"items",
						":itemId"
					],
					"variable": [
						{
							"key": "itemId",
							"value": "1",
							"description": "Cart item ID"
						}
					]
				},
				"description": "Example: Change only the size/options of a cart item without affecting quantity or addons."
			},
			"response": []
		},
		{
			"name": "Update Cart Item - Remove All Addons",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"addons\": []\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/user/cart/items/:itemId",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"cart",
						"items",
						":itemId"
					],
					"variable": [
						{
							"key": "itemId",
							"value": "1",
							"description": "Cart item ID"
						}
					]
				},
				"description": "Example: Remove all addons from a cart item.\n\n**Note:** This uses JSON body because form-data cannot send an empty array. To remove all addons, you need to send an empty addons array."
			},
			"response": []
		},
		{
			"name": "Update Cart Item - Add/Update Addons",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "addons[0][addon_id]",
							"value": "1",
							"description": "First addon ID",
							"type": "text"
						},
						{
							"key": "addons[0][quantity]",
							"value": "2",
							"description": "First addon quantity",
							"type": "text"
						},
						{
							"key": "addons[1][addon_id]",
							"value": "3",
							"description": "Second addon ID",
							"type": "text"
						},
						{
							"key": "addons[1][quantity]",
							"value": "1",
							"description": "Second addon quantity",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/user/cart/items/:itemId",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"cart",
						"items",
						":itemId"
					],
					"variable": [
						{
							"key": "itemId",
							"value": "1",
							"description": "Cart item ID"
						}
					]
				},
				"description": "Example: Replace current addons with new set.\n\n**Note:** This replaces ALL existing addons with the ones specified."
			},
			"response": []
		},
		{
			"name": "Remove Item from Cart",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/user/cart/items/:itemId",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"cart",
						"items",
						":itemId"
					],
					"variable": [
						{
							"key": "itemId",
							"value": "1",
							"description": "Cart item ID to remove"
						}
					]
				},
				"description": "Remove a specific item from the cart.\n\n**Note:** If this is the last item in the cart, the entire cart will be deleted."
			},
			"response": []
		},
		{
			"name": "Clear Cart",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/user/cart",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"cart"
					]
				},
				"description": "Clear the entire cart (delete cart and all items)."
			},
			"response": []
		},
		{
			"name": "Replace Cart (Different Store)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "product_id",
							"value": "10",
							"description": "Required - Product ID from different store",
							"type": "text"
						},
						{
							"key": "quantity",
							"value": "1",
							"description": "Required - Quantity (1-99)",
							"type": "text"
						},
						{
							"key": "option_values[0]",
							"value": "1",
							"description": "Optional - Option value ID",
							"type": "text",
							"disabled": true
						},
						{
							"key": "addons[0][addon_id]",
							"value": "1",
							"description": "Optional - Addon ID",
							"type": "text",
							"disabled": true
						},
						{
							"key": "addons[0][quantity]",
							"value": "1",
							"description": "Optional - Addon quantity",
							"type": "text",
							"disabled": true
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/user/cart/replace",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"cart",
						"replace"
					]
				},
				"description": "Replace the current cart with a new cart containing items from a different store.\n\nThis will:\n1. Delete the old cart completely\n2. Create a new cart with the specified product"
			},
			"response": []
		}
	]
}