{
	"info": {
		"_postman_id": "vendor-branch-management-001",
		"name": "Vendor Branch Management",
		"description": "API endpoints for vendor branch management. Vendors can manage branches for their own store.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{vendor_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "vendor_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "branch_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Vendor Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.access_token) {",
									"        pm.collectionVariables.set('vendor_token', jsonData.data.access_token);",
									"        console.log('Token saved:', jsonData.data.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "email",
									"value": "vendor@test.com",
									"type": "text"
								},
								{
									"key": "password",
									"value": "password123",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/vendor/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"vendor",
								"login"
							]
						},
						"description": "Login as vendor to get authentication token"
					},
					"response": []
				},
				{
					"name": "Vendor Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/vendor/profile",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"vendor",
								"profile"
							]
						},
						"description": "Get vendor profile information"
					},
					"response": []
				}
			],
			"description": "Vendor authentication endpoints"
		},
		{
			"name": "Branch Management",
			"item": [
				{
					"name": "Get All Branches",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/vendor/branches",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"vendor",
								"branches"
							],
							"query": [
								{
									"key": "is_active",
									"value": "1",
									"description": "Filter by active status (0 or 1)",
									"disabled": true
								},
								{
									"key": "is_main",
									"value": "1",
									"description": "Filter by main branch (0 or 1)",
									"disabled": true
								},
								{
									"key": "search",
									"value": "downtown",
									"description": "Search by name or address",
									"disabled": true
								}
							]
						},
						"description": "Get all branches for the authenticated vendor's store with optional filters"
					},
					"response": []
				},
				{
					"name": "Get Main Branch",
					"request": {
						"method": "GET",
