								"branches",
								"{{branch_id}}"
							]
						},
						"description": "Get details of a specific branch by ID"
					},
					"response": []
				},
				{
					"name": "Create Branch",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.collectionVariables.set('branch_id', jsonData.data.id);",
									"        console.log('Branch ID saved:', jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
