        "name": "Makook Category API",
        "description": "Postman collection for Category Management (User, Admin, and Vendor APIs) using form-data for POST/PUT requests.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "User API",
            "item": [
                {
                    "name": "Get All Categories with Products",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{local}}user/categories/all-with-products?module_id=1",
                            "host": [
                                "{{local}}user"
                            ],
                            "path": [
                                "categories",
                                "all-with-products"
                            ],
                            "query": [
                                {
                                    "key": "module_id",
                                    "value": "1",
                                    "description": "Optional: Filter by module"
                                }
                            ]
                        },
                        "description": "Get all categories and their related products (optionally filtered by module)."
                    },
                    "response": []
                },
                {
                    "name": "Get Categories by Module",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{local}}user/categories/by-module/1",
                            "host": [
                                "{{local}}user"
                            ],
                            "path": [
                                "categories",
                                "by-module",
                                "1"
                            ]
                        },
                        "description": "Get all top-level categories for a specific module."
                    },
                    "response": []
                },
                {
                    "name": "Get Category Details",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{local}}user/categories/1",
                            "host": [
                                "{{local}}user"
                            ],
                            "path": [
                                "categories",
                                "1"
                            ]
                        },
                        "description": "Get a main category with its sub-categories and products."
                    },
                    "response": []
                },
                {
                    "name": "Get Subcategories with Products",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{local}}user/categories/1/subcategories",
                            "host": [
                                "{{local}}user"
                            ],
                            "path": [
                                "categories",
                                "1",
                                "subcategories"
                            ]
                        },
                        "description": "Get only the list of sub-categories for a given main category, with their products."
                    },
                    "response": []
                }
            ]
        },
