						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"transaction_id\": \"367786330\",\n  \"order_id\": \"415312014\",\n  \"amount_cents\": 10000,\n  \"currency\": \"EGP\",\n  \"success\": true,\n  \"is_3d_secure\": true,\n  \"card_type\": \"MasterCard\",\n  \"card_pan\": \"2346\",\n  \"gateway_response\": \"Approved\",\n  \"txn_response_code\": \"APPROVED\",\n  \"integration_id\": 5385685,\n  \"hmac\": \"bef21618f8d41ae654bf...\",\n  \"created_at\": \"2025-11-10T14:50:32.722525\",\n  \"merchant_commission\": 0,\n  \"accept_fees\": 0\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/orders/{{order_id}}/confirm-payment",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"orders",
						"{{order_id}}",
						"confirm-payment"
					]
				},
				"description": "**Legacy endpoint** for confirming payment after order creation.\n\n**Note:** This endpoint is optional. Payment details can now be sent directly with the checkout endpoint. This remains available for:\n- Backward compatibility\n- Async payment confirmations\n- Webhook-based updates\n- Two-step payment flows\n\n**Prerequisites:**\n- Order must exist with `pending_payment` status\n- Order must have `online` payment method\n\n**Expected Response:**\n```json\n{\n  \"success\": true,\n  \"message\": \"Payment confirmed successfully\",\n  \"data\": {\n    \"order\": {\n      \"id\": 1,\n      \"order_number\": \"ORD-20251111-00001\",\n      \"status\": \"confirmed\",\n      \"payment_status\": \"paid\"\n    }\n  }\n}\n```"
			},
			"response": []
