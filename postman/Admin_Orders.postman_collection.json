{
    "info": {
        "_postman_id": "admin-orders-collection",
        "name": "Admin Orders API",
        "description": "Admin endpoints for managing orders.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{admin_token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000/api/admin",
            "type": "string"
        },
        {
            "key": "admin_token",
            "value": "YOUR_ADMIN_TOKEN_HERE",
            "type": "string"
        },
        {
            "key": "order_id",
            "value": "1",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. List Orders",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Accept-Language",
                        "value": "en",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/orders?page=1&per_page=15",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "orders"
                    ],
                    "query": [
                        {
                            "key": "page",
                            "value": "1",
                            "description": "Page number (default: 1)"
                        },
                        {
                            "key": "per_page",
                            "value": "15",
                            "description": "Items per page (default: 15, max: 100)"
                        },
                        {
                            "key": "store_id",
                            "value": "",
                            "description": "Filter by store ID (optional)",
                            "disabled": true
                        },
                        {
                            "key": "status",
                            "value": "pending",
                            "description": "Filter by order status (optional)",
                            "disabled": true
                        },
                        {
                            "key": "payment_status",
                            "value": "paid",
                            "description": "Filter by payment status (optional)",
                            "disabled": true
                        },
                        {
                            "key": "search",
                            "value": "",
                            "description": "Search by order number (optional)",
                            "disabled": true
                        }
                    ]
                },
                "description": "Get list of orders with pagination and filtering options."
            },
            "response": []
        },
        {
            "name": "2. Create Order",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Accept-Language",
                        "value": "en",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"user_id\": 1,\n    \"address_id\": 1,\n    \"payment_method\": \"cash\",\n    \"payment_status\": \"pending\",\n    \"notes\": \"Admin created order\",\n    \"discount\": 0,\n    \"delivery_fee\": 10,\n    \"tax\": 5,\n    \"items\": [\n        {\n            \"product_id\": 1,\n            \"quantity\": 2,\n            \"special_instructions\": \"No onions\",\n            \"options\": [\n                {\n                    \"product_option_value_id\": 1\n                }\n            ],\n            \"addons\": [\n                {\n                    \"addon_id\": 1,\n                    \"quantity\": 1\n                }\n            ]\n        }\n    ]\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/orders",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "orders"
                    ]
                },
                "description": "Create a new order from the admin side. Admin can specify user, items, payment details, and address.\n\n**Required Fields:**\n- `user_id`: ID of the user placing the order\n- `address_id` OR `address`: Either existing address ID or full address object\n- `payment_method`: 'cash' or 'online'\n- `payment_status`: 'pending', 'paid', 'failed', or 'refunded'\n- `items`: Array of order items with product_id, quantity, and optional options/addons\n\n**Optional Fields:**\n- `order_status`: Order status (defaults based on payment method)\n- `simple_status`: Simple status (defaults to 'in_progress')\n- `notes`: Order notes\n- `discount`: Discount amount\n- `delivery_fee`: Delivery fee\n- `tax`: Tax amount"
            },
            "response": []
        },
        {
            "name": "3. Show Order",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Accept-Language",
                        "value": "en",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/orders/{{order_id}}",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "orders",
                        "{{order_id}}"
                    ]
                },
                "description": "Get details of a specific order."
            },
            "response": []
        }
    ]
}