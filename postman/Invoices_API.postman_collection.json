{
    "info": {
        "_postman_id": "vendor-invoices-collection",
        "name": "Invoices API",
        "description": "API endpoints for managing vendor and delivery invoices in the Makook application",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Admin - Vendor Invoices",
            "description": "Admin endpoints for vendor invoice management",
            "item": [
                {
                    "name": "List All Vendor Invoices",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/vendor-invoices",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "vendor-invoices"
                            ]
                        },
                        "description": "Get a paginated list of all vendor invoices with their associated store information."
                    },
                    "response": []
                },
                {
                    "name": "Get Vendor Invoice Details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/vendor-invoices/:id",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "vendor-invoices",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Get a specific vendor invoice with all related orders and store details."
                    },
                    "response": []
                },
                {
                    "name": "Mark Vendor Invoice as Paid",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/vendor-invoices/:id/pay",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "vendor-invoices",
                                ":id",
                                "pay"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Mark a vendor invoice as paid. Updates invoice status and sets is_paid_to_vendor=true for all related orders."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Admin - Delivery Invoices",
            "description": "Admin endpoints for delivery invoice management",
            "item": [
                {
                    "name": "List All Delivery Invoices",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/delivery-invoices?status=pending&delivery_id=1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "delivery-invoices"
                            ],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "pending",
                                    "description": "Filter by status (pending/paid)"
                                },
                                {
                                    "key": "delivery_id",
                                    "value": "1",
                                    "description": "Filter by delivery driver ID"
                                }
                            ]
                        },
                        "description": "Get a paginated list of all delivery invoices. Shows cash orders pending handover from delivery drivers."
                    },
                    "response": []
                },
                {
                    "name": "Get Delivery Invoice Details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/delivery-invoices/:id",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "delivery-invoices",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Get a specific delivery invoice with all related orders."
                    },
                    "response": []
                },
                {
                    "name": "Mark Delivery Invoice as Paid",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/admin/delivery-invoices/:id/pay",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "delivery-invoices",
                                ":id",
                                "pay"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Mark a delivery invoice as paid (cash handed over). Updates invoice status and sets is_cash_handed_over=true for all related orders."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Vendor - My Invoices",
