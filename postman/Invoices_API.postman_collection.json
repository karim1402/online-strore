                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{vendor_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/vendor/invoices/:id",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "vendor",
                                "invoices",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Get a specific invoice with all its related orders."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Delivery - My Invoices",
            "description": "Delivery driver endpoints to view their own invoices",
            "item": [
