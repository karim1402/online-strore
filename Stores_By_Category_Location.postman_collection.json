{
	"info": {
		"_postman_id": "stores-by-category-location-001",
		"name": "Stores by Category with Location",
		"description": "API collection for getting stores filtered by main category ID and ordered by distance from user location",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost/api",
			"type": "string"
		},
		{
			"key": "main_category_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "test_latitude",
			"value": "30.0444",
			"type": "string"
		},
		{
			"key": "test_longitude",
			"value": "31.2357",
			"type": "string"
		},
		{
			"key": "user_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Guest User - Basic Request",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has success flag\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"});",
							"",
							"pm.test(\"Response has stores array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data).to.have.property('stores');",
							"    pm.expect(jsonData.data.stores).to.be.an('array');",
							"});",
							"",
							"pm.test(\"Response has pagination\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data).to.have.property('pagination');",
							"    pm.expect(jsonData.data.pagination).to.have.property('current_page');",
							"    pm.expect(jsonData.data.pagination).to.have.property('per_page');",
							"    pm.expect(jsonData.data.pagination).to.have.property('total');",
							"});",
							"",
							"pm.test(\"Response has user_location\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data).to.have.property('user_location');",
							"    pm.expect(jsonData.data.user_location.source).to.eql('provided');",
							"});",
							"",
							"pm.test(\"Stores are sorted by distance (if any)\", function () {",
							"    var jsonData = pm.response.json();",
							"    var stores = jsonData.data.stores;",
							"    if (stores.length > 1) {",
							"        for (let i = 0; i < stores.length - 1; i++) {",
							"            pm.expect(stores[i].distance_km).to.be.at.most(stores[i + 1].distance_km);",
							"        }",
							"    }",
							"});",
							"",
							"pm.test(\"Each store has required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    var stores = jsonData.data.stores;",
							"    if (stores.length > 0) {",
							"        var store = stores[0];",
							"        pm.expect(store).to.have.property('id');",
							"        pm.expect(store).to.have.property('name');",
							"        pm.expect(store).to.have.property('distance_km');",
							"        pm.expect(store).to.have.property('closest_branch');",
							"        pm.expect(store.closest_branch).to.have.property('distance_km');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/user/stores/by-category/{{main_category_id}}?latitude={{test_latitude}}&longitude={{test_longitude}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"stores",
						"by-category",
						"{{main_category_id}}"
					],
					"query": [
						{
							"key": "latitude",
							"value": "{{test_latitude}}"
						},
						{
							"key": "longitude",
							"value": "{{test_longitude}}"
						}
					]
				},
				"description": "Basic request with guest user providing coordinates"
			},
			"response": []
		},
		{
			"name": "2. Authenticated User - Auto Location",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 400\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
							"});",
							"",
							"if (pm.response.code === 200) {",
							"    pm.test(\"Response has success flag\", function () {",
							"        var jsonData = pm.response.json();",
							"        pm.expect(jsonData.success).to.eql(true);",
							"    });",
							"    ",
							"    pm.test(\"Location source is default_address\", function () {",
							"        var jsonData = pm.response.json();",
							"        pm.expect(jsonData.data.user_location.source).to.eql('default_address');",
							"    });",
							"} else {",
							"    pm.test(\"Error message about default address\", function () {",
							"        var jsonData = pm.response.json();",
							"        pm.expect(jsonData.success).to.eql(false);",
							"        pm.expect(jsonData.message).to.include('address');",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Make sure user_token is set in collection variables"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{user_token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/user/stores/by-category/{{main_category_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"stores",
						"by-category",
						"{{main_category_id}}"
					]
				},
				"description": "Authenticated user without coordinates - uses default address"
			},
			"response": []
		},
		{
			"name": "3. With Search Filter",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has stores array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.stores).to.be.an('array');",
							"});",
							"",
							"pm.test(\"Stores match search term (if any)\", function () {",
							"    var jsonData = pm.response.json();",
							"    var stores = jsonData.data.stores;",
							"    var searchTerm = pm.variables.get('search_term');",
							"    if (stores.length > 0) {",
							"        stores.forEach(function(store) {",
							"            var nameMatch = store.name_en.toLowerCase().includes(searchTerm.toLowerCase()) || ",
							"                           store.name_ar.includes(searchTerm);",
							"            pm.expect(nameMatch).to.be.true;",
							"        });",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.variables.set('search_term', 'pizza');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept-Language",
						"value": "en",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/user/stores/by-category/{{main_category_id}}?latitude={{test_latitude}}&longitude={{test_longitude}}&search=pizza",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"stores",
						"by-category",
						"{{main_category_id}}"
					],
					"query": [
						{
							"key": "latitude",
							"value": "{{test_latitude}}"
						},
						{
							"key": "longitude",
							"value": "{{test_longitude}}"
						},
						{
							"key": "search",
							"value": "pizza"
						}
					]
				},
				"description": "Search for stores matching 'pizza' in name"
			},
			"response": []
		},
