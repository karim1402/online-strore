{
    "info": {
        "_postman_id": "otp-authentication-collection",
        "name": "OTP Authentication",
        "description": "Collection for User OTP Authentication endpoints including Verification, Resend Code, Forgot Password, and Reset Password.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "User Authentication",
            "item": [
                {
                    "name": "Verify Email",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "en",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "email",
                                    "value": "user@example.com",
                                    "description": "User's email",
                                    "type": "text"
                                },
                                {
                                    "key": "code",
                                    "value": "1234",
                                    "description": "Verification code sent to email",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/user/verify-email",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "user",
                                "verify-email"
                            ]
                        },
                        "description": "Verify user email using the code sent during registration."
                    },
                    "response": []
                },
                {
                    "name": "Resend Verification Code",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "en",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "email",
                                    "value": "user@example.com",
                                    "description": "User's email",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/user/resend-verification-code",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "user",
                                "resend-verification-code"
                            ]
                        },
                        "description": "Resend the verification code if it expired or was not received."
                    },
                    "response": []
                },
                {
                    "name": "Forgot Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "en",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "email",
                                    "value": "user@example.com",
                                    "description": "User's email",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/user/forgot-password",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "user",
                                "forgot-password"
                            ]
                        },
                        "description": "Request a password reset code via email."
                    },
                    "response": []
                },
                {
                    "name": "Reset Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "en",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "email",
                                    "value": "user@example.com",
                                    "description": "User's email",
                                    "type": "text"
                                },
                                {
                                    "key": "code",
                                    "value": "1234",
                                    "description": "Reset code sent to email",
                                    "type": "text"
                                },
                                {
                                    "key": "password",
                                    "value": "newpassword123",
                                    "description": "New password",
                                    "type": "text"
                                },
                                {
                                    "key": "password_confirmation",
                                    "value": "newpassword123",
                                    "description": "Confirm new password",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/user/reset-password",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "user",
                                "reset-password"
                            ]
                        },
                        "description": "Reset password using the reset code."
                    },
                    "response": []
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        }
    ]
}