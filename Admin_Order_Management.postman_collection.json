{
    "info": {
        "_postman_id": "admin-order-management",
        "name": "Admin Order Management",
        "description": "Collection for Admin Order endpoints: Mark Ready to Pick and Cancel.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Mark Ready To Pick",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Accept-Language",
                        "value": "en",
                        "type": "text"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{admin_token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/admin/orders/{{order_id}}/mark-ready",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "admin",
                        "orders",
                        "{{order_id}}",
                        "mark-ready"
                    ]
                },
                "description": "Mark an order as ready to pick. Requires Admin Token."
            },
            "response": []
        },
        {
            "name": "Cancel Order",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Accept-Language",
                        "value": "en",
                        "type": "text"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{admin_token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/admin/orders/{{order_id}}/cancel",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "admin",
                        "orders",
                        "{{order_id}}",
                        "cancel"
                    ]
                },
                "description": "Cancel an order. Requires Admin Token."
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        },
        {
            "key": "admin_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "order_id",
            "value": "1",
            "type": "string"
        }
    ]
}