{
	"info": {
		"_postman_id": "user-address-collection-001",
		"name": "User Address Management API",
		"description": "Complete API collection for user address management endpoints. Includes create, read, update, delete operations for user addresses with support for villa, apartment, and office types.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "address_id",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Get All User Addresses",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/user/addresses?search=&address_type=&is_default=",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"addresses"
					],
					"query": [
						{
							"key": "search",
							"value": "",
							"description": "Search in address_name, building_name, street_name, or landmark"
						},
						{
							"key": "address_type",
							"value": "",
							"description": "Filter by address type: villa, apartment, or office"
						},
						{
							"key": "is_default",
							"value": "",
							"description": "Filter by default status: true or false"
						}
					]
				},
				"description": "Retrieve all addresses for the authenticated user. Supports filtering by address type, default status, and searching across multiple fields."
			},
			"response": []
		},
		{
			"name": "Get Single Address",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/user/addresses/{{address_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"addresses",
						"{{address_id}}"
					]
				},
				"description": "Get details of a specific address by ID. Only returns addresses belonging to the authenticated user."
			},
			"response": []
		},
